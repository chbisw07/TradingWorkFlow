# Copy to .env in apps/api; never commit real secrets.
TWF_ENVIRONMENT=development
TWF_DATABASE_URL=sqlite+pysqlite:///./twf.db
# Optional metadata defaults: twf-api and the installed package version.
# TWF_SERVICE_NAME=twf-api
# TWF_SERVICE_VERSION=0.1.0
# TWF_API_VERSION=v1
# TWF_API_PREFIX=/api/v1
# TWF_LOG_LEVEL=INFO
# JSON list; production/test default to no cross-origin access.
# TWF_CORS_ORIGINS=["http://localhost:3000"]
# Required exact web origin(s) for login/logout; HTTPS only in production.
# TWF_SESSION_TTL_SECONDS=28800

# PostgreSQL deployment: inject a real URL through the environment/secret manager.
# TWF_DATABASE_URL=postgresql+psycopg://DB_USER:REPLACE_ME@DB_HOST:5432/DB_NAME
# postgresql:// is normalized to postgresql+psycopg://. SQL echo is always OFF.
# Run migrations explicitly: .venv/bin/alembic upgrade head

# Broker V1: stable credential master key, generated once and kept outside Git/DB.
# TWF_CREDENTIAL_MASTER_KEY=<Fernet key; see docs/TWF_BROKER_V1_VERTICAL_SLICE.md>
TWF_BROKER_CALLBACK_URL=http://localhost:3000/brokers/callback
# TWF_BROKER_DEADLINE_SECONDS=20
# Missing/invalid keys fail closed. Inject the same key into every API instance.

# Broker V2: opt in to manual live LIMIT/SL placement after acceptance.
TWF_BROKER_MANUAL_TRADING_ENABLED=false

# TradingView real evidence: register a public OAuth client for this exact callback.
# Never commit an issued client secret; TWF uses token_endpoint_auth_method=none.
# TWF_MCP_PROVIDERS=[{"schema_version":"mcp.connection.v1","provider_id":"tradingview","display_name":"TradingView","endpoint":"https://mcp.tradingview.com/mcp","auth_mode":"OAUTH_2_1","oauth":{"issuer":"https://www.tradingview.com","authorization_endpoint":"https://www.tradingview.com/mcp/oauth/authorize","token_endpoint":"https://www.tradingview.com/mcp/oauth/token","revocation_endpoint":"https://www.tradingview.com/mcp/oauth/revoke","client_id":"REPLACE_WITH_REGISTERED_PUBLIC_CLIENT_ID","redirect_uri":"http://localhost:3000/settings/mcp/callback","scopes":["mcp:read","mcp:tools"]},"timeout_seconds":10,"max_response_bytes":262144,"max_tools":64,"max_pages":4,"retry_count":0,"refresh_policy":"EXPLICIT","health_policy":"INITIALIZE_AND_LIST_TOOLS"}]
# TWF_TRADINGVIEW_SCAN={"enabled":true,"response_contract_verified":true,"response_contract":"nested-data-v1","market":"india","max_items":20,"timeout_seconds":8,"snapshot_ttl_seconds":60,"sort_by":"volume","sort_order":"desc"}
