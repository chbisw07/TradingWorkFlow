FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY apps/api/requirements.lock ./requirements.lock
RUN pip install --no-cache-dir -r requirements.lock
COPY apps/api/pyproject.toml ./pyproject.toml
COPY apps/api/src ./src
COPY apps/api/alembic.ini ./alembic.ini
COPY apps/api/alembic ./alembic
RUN pip install --no-cache-dir --no-deps . && useradd --create-home twf && chown twf:twf /app
USER twf
EXPOSE 8000
CMD ["uvicorn", "twf.main:create_app", "--factory", "--host", "0.0.0.0", "--port", "8000", "--no-access-log"]
